# The touch panel on the Pi's own screen, read by printpi-panel.service.
# The token matches PRINTPI_PANEL_TOKEN in app.env and signs the kiosk browser in.
PRINTPI_PANEL_TOKEN=
PRINTPI_PANEL_URL=http://127.0.0.1/panel
# Output as wlr-randr names it (HDMI-A-2, DSI-1); empty picks the first one.
PRINTPI_PANEL_OUTPUT=
# 0, 90, 180 or 270 for a screen mounted on its side or upside down.
PRINTPI_PANEL_ROTATE=0
# A mode the screen prefers but the kernel does not list, e.g. 1024x600@60.
PRINTPI_PANEL_MODE=
# Scale factor of the compositor, e.g. 1.25 for a 1024x600 screen.
PRINTPI_PANEL_SCALE=
