# Environment for the PrintPi daemon, read by systemd from /etc/printpi/daemon.env
PRINTPI_PORT=/dev/printer
PRINTPI_BAUD=115200
PRINTPI_REDIS_URL=redis://127.0.0.1:6379/0
PRINTPI_SERIAL_LOG=/var/log/printpi/serial.log
# Timelapse recordings survive release switches.
PRINTPI_TIMELAPSE_DIR=/var/lib/printpi/timelapse
